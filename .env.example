# Copy to .env.local for your own computer. In Vercel: Settings → Environment Variables
# (paste this whole file into the first box and Vercel splits it up).

# ── Addresses ──
# sales site, sign-up and API
APP_URL=https://create.myqr.co.nz
# buddies live at <name>.myqr.co.nz (blank = APP_URL/b/<name>)
BUDDY_DOMAIN=myqr.co.nz
LOGIN_URL=https://login.myqr.co.nz
# scripts/styles load from here when a page is served via teddy.myqr.co.nz
ASSET_PREFIX=https://create.myqr.co.nz
# the party site, for the shared name check
PARTY_SITE_URL=https://myqr.co.nz

# ── Database (Neon; the same database as the other myQR apps is fine: tables start with qb_) ──
DATABASE_URL=

# ── Sign-in links and parent sessions: any long random string (openssl rand -hex 32) ──
SESSION_SECRET=

# ── Stripe (the shared myQR account) ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# a recurring monthly Price (e.g. $4.99 NZD)
STRIPE_PRICE_MONTHLY=
# a recurring yearly Price (e.g. $39 NZD)
STRIPE_PRICE_YEARLY=
PRICE_MONTHLY_LABEL=$4.99 a month
PRICE_YEARLY_LABEL=$39 a year
TRIAL_DAYS=7

# ── Email (Resend). Blank = emails are printed in the server log ──
RESEND_API_KEY=
FROM_EMAIL=QR Buddy <hello@myqr.co.nz>
SUPPORT_EMAIL=adminmyqr@gmail.com

# ── Admin (admin.myqr.co.nz). HQ_PRODUCT must match the product code in the admin ──
HQ_URL=https://admin.myqr.co.nz
HQ_SECRET=
HQ_PRODUCT=buddy

# ── Daily cleanup job (Vercel sends it automatically once set) ──
CRON_SECRET=

# ── Animation (optional) ──
# When the Rive animator delivers qr-buddy.riv, put it in public/rive/ and set this (full address, because buddies
# are served on teddy.myqr.co.nz). Unset = the SVG buddy only.
NEXT_PUBLIC_BUDDY_RIVE=
# Optional self-hosted Rive runtime (copy the .wasm from node_modules/@rive-app/webgl2/ into public/rive/). Unset = Rive's CDN.
NEXT_PUBLIC_BUDDY_RIVE_WASM=
